# Local dev credentials & ports for docker-compose. Copy to `.env` and edit.
# `.env` is git-ignored — never commit real secrets.

# --- PostgreSQL ---
POSTGRES_USER=taskfloww
POSTGRES_PASSWORD=taskfloww
POSTGRES_DB=taskfloww
POSTGRES_PORT=5432

# --- RabbitMQ ---
RABBITMQ_USER=taskfloww
RABBITMQ_PASSWORD=taskfloww
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672

# --- Prometheus ---
PROMETHEUS_PORT=9090

# --- Grafana ---
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
GRAFANA_PORT=3000
